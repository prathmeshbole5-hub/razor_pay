# RecoverAI Backend Environment Variables Example
# Copy to backend/.env and populate required values for deployment

HOST=0.0.0.0
PORT=8002
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Razorpay Test Mode Credentials (Backend Only - NEVER expose to frontend)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_ENABLED=true

# Database Path Configuration (Optional override; defaults to relative data/recoverai.db)
DATABASE_PATH=
DATABASE_URL=

DEMO_MODE=true

# Google Gemini Conversational Copilot Credentials (Backend Only - NEVER expose to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
